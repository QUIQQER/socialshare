<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/socialshare" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/socialshare" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="communication.social-sharing">
                <title>Social sharing</title>
                <description>
                    Provides configurable page-sharing controls for selected social networks and e-mail with network-specific share links, accessible labels, popup handling, and customizable button themes.
                </description>
            </capability>

            <capability id="seo.social-preview-metadata">
                <title>Social preview metadata</title>
                <description>
                    Publishes configurable per-page Open Graph, X / Twitter Card, and Schema.org metadata for accurate social link titles, descriptions, content types, authors, locales, URLs, and images.
                </description>
            </capability>
        </capabilities>

        <image src='URL_OPT_DIR/quiqqer/socialshare/bin/images/Logo.jpg'/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/socialshare/bin/images/preview/Socialshare_1.jpg"/>
            <image src="URL_OPT_DIR/quiqqer/socialshare/bin/images/preview/Socialshare_2.jpg"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/socialshare]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/socialshare/-/work_items]]></issues>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>
    </package>
</quiqqer>
