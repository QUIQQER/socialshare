<?xml version="1.0" encoding="UTF-8"?>
<quiqqer>
    <project>

        <settings>
            <config>
                <section name="socialshare.settings">

                    <conf name="Facebook">
                        <type><![CDATA[bool]]></type>
                        <defaultvalue>1</defaultvalue>
                    </conf>
                    <conf name="Twitter">
                        <type><![CDATA[bool]]></type>
                        <defaultvalue>1</defaultvalue>
                    </conf>
                    <conf name="Whatsapp">
                        <type><![CDATA[bool]]></type>
                        <defaultvalue>1</defaultvalue>
                    </conf>
                    <conf name="Pinterest">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Mail">
                        <type><![CDATA[bool]]></type>
                        <defaultvalue>1</defaultvalue>
                    </conf>
                    <conf name="LinkedIn">
                        <type><![CDATA[bool]]></type>
                        <defaultvalue>1</defaultvalue>
                    </conf>
                    <conf name="Xing">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="WordPress">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Reddit">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Telegram">
                        <type><![CDATA[bool]]></type>
                    </conf>

                    <conf name="Surfingbird">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="VK">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="RenRen">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Readability">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Pocket">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Odnoklassniki">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="MoiMir">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Livejournal">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Liveinternet">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Line">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Viber">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Delicious">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="StumbleUpon">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Evernote">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Instapaper">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Blogger">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Baidu">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Buffer">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Digg">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Tumblr">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="Weibo">
                        <type><![CDATA[bool]]></type>
                    </conf>

                    <conf name="general.standardImage">
                        <type><![CDATA[bool]]></type>
                    </conf>
                    <conf name="general.showLabel">
                        <type><![CDATA[bool]]></type>
                        <defaultvalue>1</defaultvalue>
                    </conf>
                    <conf name="general.showIcon">
                        <type><![CDATA[bool]]></type>
                        <defaultvalue>1</defaultvalue>
                    </conf>
                    <conf name="general.siteName">
                        <type><![CDATA[string]]></type>
                    </conf>

                    <conf name="general.theme">
                        <type><![CDATA[string]]></type>
                    </conf>


                    <conf name="twitter.card">
                        <type><![CDATA[string]]></type>
                        <defaultvalue>summary_large_image</defaultvalue>
                    </conf>
                    <conf name="twitter.site">
                        <type><![CDATA[string]]></type>
                    </conf>
                    <conf name="twitter.creator">
                        <type><![CDATA[string]]></type>
                    </conf>
                </section>
            </config>

            <window>
                <categories>
                    <category name="socialshare">
                        <text>
                            <locale group="quiqqer/socialshare"
                                    var="socialshare.settings.category"/>
                        </text>
                        <icon>fa-solid fa-share-nodes</icon>

                        <settings title="socialshare.settings" name="socialshare.settings.general">
                            <title>
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.title"/>
                                </text>
                            </title>

                            <input conf="socialshare.settings.general.standardImage"
                                   type="text" class="media-image">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.standardImage"/>
                                </text>
                                <description>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.standardImage.desc"/>
                                </description>
                            </input>

                            <input conf="socialshare.settings.general.showLabel" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.showLabel"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.general.showIcon" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.showIcon"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.general.siteName">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.siteName" />
                                </text>
                            </input>

                            <select conf="socialshare.settings.general.theme">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.theme"/>
                                </text>
                                <option value="button-classic">
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.theme.button-classic"/>
                                </option>
                                <option value="button">
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.theme.button"/>
                                </option>
                                <option value="button-outline">
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.theme.button-outline"/>
                                </option>
                                <option value="link">
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.theme.link"/>
                                </option>
                                <option value="link-muted">
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.general.theme.link-muted"/>
                                </option>
                            </select>
                        </settings>

                        <settings title="socialshare.settings" name="socialshare.settings.twitter">
                            <title>
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.title"/>
                                </text>
                            </title>
                            <select conf="socialshare.settings.twitter.card">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.card" />
                                </text>

                                <option value="summary">
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.card.summary" />
                                </option>
                                <option value="summary_large_image">
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.card.summaryLargeImage" />
                                </option>
                                <option value="player">
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.card.player" />
                                </option>
                            </select>
                            <input conf="socialshare.settings.twitter.site">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.site" />
                                </text>
                                <description>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.site.description" />
                                </description>
                            </input>
                            <input conf="socialshare.settings.twitter.creator">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.creator" />
                                </text>
                                <description>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.twitter.creator.description" />
                                </description>
                            </input>
                        </settings>

                        <settings title="socialshare.settings" name="socialshare.settings">
                            <title>
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.title"/>
                                </text>
                            </title>
                            <input conf="socialshare.settings.Facebook" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.facebook"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.Twitter" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.twitter"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.Whatsapp" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.whatsapp"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.Pinterest" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.pinterest"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.Mail" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.mail"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.LinkedIn" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.linkedin"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.Xing" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.xing"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.WordPress" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.wordpress"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.Reddit" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.reddit"/>
                                </text>
                            </input>
                            <input conf="socialshare.settings.Telegram" type="checkbox">
                                <text>
                                    <locale group="quiqqer/socialshare"
                                            var="socialshare.settings.show.telegram"/>
                                </text>
                            </input>
                        </settings>
                    </category>
                </categories>

            </window>
        </settings>

    </project>
</quiqqer>
